<Window x:Class="ImgShare.Ui.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ImgShare.Ui"
        Width="440" Height="680" MinWidth="360" MinHeight="420"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="Manual"
        Background="{DynamicResource Bg}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Text}"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Pro Nachricht eigene Instanz (x:Shared=False), per Rechtsklick, Menütaste oder Shift+F10 -->
        <ContextMenu x:Key="MessageMenu" x:Shared="False">
            <MenuItem Header="Kopieren" InputGestureText="Strg+C" Click="Copy_Click"/>
            <MenuItem Header="Bild öffnen" InputGestureText="Enter" Click="Open_Click"
                      Visibility="{Binding HasImage, Converter={StaticResource BoolVis}}"/>
            <MenuItem Header="Speichern unter …" Click="Save_Click"
                      Visibility="{Binding HasImage, Converter={StaticResource BoolVis}}"/>
            <MenuItem Header="Erneut senden" Click="Retry_Click"
                      Visibility="{Binding IsFailed, Converter={StaticResource BoolVis}}"/>
        </ContextMenu>

        <Style x:Key="MessageContainer" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleText}"/>
            <Setter Property="ContextMenu" Value="{StaticResource MessageMenu}"/>
            <EventSetter Event="KeyDown" Handler="Item_KeyDown"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" BorderThickness="2" BorderBrush="Transparent" CornerRadius="10" Padding="2,3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="ContextMenu" Value="{x:Null}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="MessageTemplate" DataType="{x:Type ui:MessageItem}">
            <Grid>
                <!-- Datumstrenner -->
                <Border Visibility="{Binding IsSeparator, Converter={StaticResource BoolVis}}"
                        HorizontalAlignment="Center" Background="{DynamicResource Chip}" CornerRadius="10" Padding="10,3" Margin="0,4">
                    <TextBlock Text="{Binding SeparatorText}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                </Border>

                <!-- Nachricht -->
                <StackPanel Visibility="{Binding IsSeparator, Converter={StaticResource InvBoolVis}}"
                            HorizontalAlignment="{Binding Align}"
                            MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Ratio}, ConverterParameter=0.78}">
                    <Border CornerRadius="{Binding BubbleRadius}" Padding="{Binding BubblePadding}" BorderThickness="1"
                            HorizontalAlignment="{Binding Align}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Incoming}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource IncomingBorder}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMine}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPending}" Value="True">
                                        <Setter Property="Opacity" Value="0.75"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <ui:MessageText Visibility="{Binding HasText, Converter={StaticResource BoolVis}}"
                                            Text="{Binding Text, Mode=OneWay}" FontSize="13.5">
                                <ui:MessageText.Style>
                                    <Style TargetType="ui:MessageText">
                                        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                        <Setter Property="LinkBrush" Value="{DynamicResource Link}"/>
                                        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                                <Setter Property="LinkBrush" Value="{DynamicResource OnAccent}"/>
                                                <Setter Property="SelectionBrush" Value="{DynamicResource OnAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:MessageText.Style>
                            </ui:MessageText>

                            <StackPanel Visibility="{Binding HasImage, Converter={StaticResource BoolVis}}">
                                <Grid Width="{Binding ImageWidth}" Height="{Binding ImageHeight}" Cursor="Hand"
                                      MouseLeftButtonUp="Image_Click" ToolTip="Klicken oder Enter zum Vergrößern">
                                    <Border CornerRadius="9" Background="{DynamicResource ImageBackdrop}"/>
                                    <TextBlock Text="Bild wird entschlüsselt …" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding IsLoadingImage, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="Bild nicht verfügbar" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding ImageFailed, Converter={StaticResource BoolVis}}"/>
                                    <Border CornerRadius="9">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding ImageCaption}" FontSize="11" Margin="6,4,6,2" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource CaptionOnAccent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Status, Zeit, Haken -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="{Binding Align}" Margin="4,3,4,0">
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,0,6,0"
                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Style="{StaticResource TextLinkButton}" Content="Erneut senden" Margin="0,0,8,0" FontSize="11"
                                Click="Retry_Click" Visibility="{Binding IsFailed, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                        <Viewbox Width="14" Height="14" Margin="4,0,0,0" ToolTip="Gelesen"
                                 Visibility="{Binding IsRead, Converter={StaticResource BoolVis}}">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconReadTicks}" Stroke="{DynamicResource ReadTick}" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <Viewbox Width="13" Height="13" Margin="4,0,0,0" ToolTip="Zugestellt"
                                 Visibility="{Binding IsDelivered, Converter={StaticResource BoolVis}}">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconTick}" Stroke="{DynamicResource TextMuted}" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0,8,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" ToolTip="Verlauf durchsuchen (Strg+F)" AutomationProperties.Name="Verlauf durchsuchen"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Search_Click">
                        <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconSearch}"/></Canvas></Viewbox>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Chat-Einstellungen" AutomationProperties.Name="Chat-Einstellungen"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Settings_Click">
                        <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconSettings}"/></Canvas></Viewbox>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="In den Infobereich minimieren (Esc)" AutomationProperties.Name="In den Infobereich minimieren"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click">
                        <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconClose}"/></Canvas></Viewbox>
                    </Button>
                </StackPanel>

                <Grid Width="34" Height="34" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Ellipse Fill="{DynamicResource Accent}"/>
                    <TextBlock x:Name="Initials" Foreground="{DynamicResource OnAccent}" FontWeight="SemiBold" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse x:Name="PresenceDot" Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-1,-1" Stroke="{DynamicResource Surface}" StrokeThickness="2" Fill="{DynamicResource Offline}"/>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ChatTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                        <Viewbox Width="12" Height="12" Margin="0,0,4,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconLock}" Stroke="{DynamicResource Lock}" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="StatusLine" FontSize="12" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Suche -->
        <Border x:Name="SearchBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel>
                <TextBox x:Name="SearchBox" Style="{StaticResource Input}" TextChanged="SearchBox_TextChanged"
                         PreviewKeyDown="SearchBox_PreviewKeyDown" Tag="Im Verlauf suchen …"
                         AutomationProperties.Name="Verlauf durchsuchen"/>
                <TextBlock x:Name="SearchHint" Margin="2,6,0,0" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                           Text="Durchsucht nur bereits geladene Nachrichten." Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Verlauf -->
        <ScrollViewer x:Name="Scroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="Scroller_ScrollChanged" Focusable="False">
            <StackPanel Margin="12,8,12,12">
                <Grid x:Name="HistoryHead" Margin="0,4,0,6" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="HistoryText" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Visibility="Collapsed"/>
                    <Button x:Name="LoadOlderButton" Style="{StaticResource TextLinkButton}" FontSize="11.5"
                            Content="Ältere Nachrichten laden" Click="LoadOlder_Click" Visibility="Collapsed"/>
                </Grid>
                <ListBox x:Name="List" ItemTemplate="{StaticResource MessageTemplate}"
                         ItemContainerStyle="{StaticResource MessageContainer}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained"
                         AutomationProperties.Name="Nachrichtenverlauf" SelectionMode="Single">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter/>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="EmptyHint" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   Margin="32" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextMuted}" IsHitTestVisible="False"/>

        <!-- Zum Ende springen -->
        <Button x:Name="JumpButton" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,12"
                Visibility="Collapsed" Click="Jump_Click" Cursor="Hand" AutomationProperties.Name="Zu den neuesten Nachrichten"
                ToolTip="Zu den neuesten Nachrichten (Strg+Ende)">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                            CornerRadius="16" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12,5 V19 M6,13 L12,19 L18,13" Stroke="{DynamicResource Text}" StrokeThickness="2.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="JumpText" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="12" Margin="6,0,0,0"
                                       Foreground="{DynamicResource Text}"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Eingabe -->
        <Border Grid.Row="3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                Padding="12,10,12,12">
            <StackPanel>
                <Border x:Name="PastePanel" Visibility="Collapsed" Background="{DynamicResource PanelBg}"
                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="32" VerticalAlignment="Center"
                                ToolTip="Bild entfernen (Esc)" AutomationProperties.Name="Bild entfernen" Click="RemovePaste_Click">
                            <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconClose}"/></Canvas></Viewbox>
                        </Button>
                        <Border Width="44" Height="44" CornerRadius="5" Margin="0,0,10,0">
                            <Border.Background>
                                <ImageBrush x:Name="PastePreview" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PasteTitle" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="PasteInfo" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock x:Name="ComposerNote" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap" Margin="2,0,0,8"/>

                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="40" Height="40" VerticalAlignment="Bottom"
                            Margin="0,0,8,0" ToolTip="Bild anhängen" AutomationProperties.Name="Bild anhängen" Click="Attach_Click">
                        <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconImage}"/></Canvas></Viewbox>
                    </Button>
                    <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource AccentIconButton}" VerticalAlignment="Bottom"
                            Margin="8,0,0,0" ToolTip="Senden (Enter)" AutomationProperties.Name="Senden" Click="Send_Click">
                        <Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" StrokeThickness="2.2" Data="{StaticResource IconSend}"/></Canvas></Viewbox>
                    </Button>
                    <TextBox x:Name="Input" Style="{StaticResource Input}" MinHeight="40" MaxHeight="140" Padding="10,9"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="13.5"
                             VerticalContentAlignment="Top" PreviewKeyDown="Input_PreviewKeyDown"
                             Tag="Nachricht oder Strg+V für Bild …" AutomationProperties.Name="Nachricht"
                             AutomationProperties.HelpText="Enter sendet, Umschalt+Enter fügt eine Zeile ein, Bild auf/ab blättert im Verlauf"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Drag & Drop -->
        <Border x:Name="DropOverlay" Grid.RowSpan="4" Visibility="Collapsed" Background="{DynamicResource Bg}" Opacity="0.94"
                IsHitTestVisible="False">
            <Border x:Name="DropFrame" Margin="16" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="10">
                <TextBlock x:Name="DropText" Text="Loslassen zum Anhängen" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Border>
    </Grid>
</Window>
