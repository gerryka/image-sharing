<Window x:Class="ImgShare.Ui.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Text}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <DockPanel>
        <!-- Titel -->
        <Border DockPanel.Dock="Top" Height="48" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="20,0,8,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" VerticalAlignment="Center"
                        ToolTip="Schließen" AutomationProperties.Name="Schließen" IsCancel="True"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Cancel_Click">
                    <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconClose}"/></Canvas></Viewbox>
                </Button>
                <TextBlock x:Name="WindowTitle" Text="Neuen Chat einrichten" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Fußzeile -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,14">
            <DockPanel>
                <Button x:Name="RemoveButton" DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Visibility="Collapsed"
                        Content="Chat entfernen" Click="Remove_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Content="Abbrechen" Click="Cancel_Click"/>
                    <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="Chat öffnen" IsDefault="True" Click="Ok_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,20,20,8">
            <TextBlock x:Name="Heading" Text="Mit Kollegen verbinden" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Margin="0,4,0,18" FontSize="13" LineHeight="19.5" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"
                       Text="Der Schlüssel verlässt nie deinen Rechner. Der Server speichert nur verschlüsselte Daten."/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Server"/>
            <TextBox x:Name="ServerBox" Style="{StaticResource Input}" Margin="0,0,0,16" AutomationProperties.Name="Server"/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Server-Zugangscode"/>
            <TextBox x:Name="InviteBox" Style="{StaticResource Input}" Margin="0,0,0,6"
                     Tag="Nur nötig, wenn du den Chat als Erste/r anlegst" AutomationProperties.Name="Server-Zugangscode"/>
            <TextBlock Margin="0,0,0,16" FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"
                       Text="Bekommst du vom Server-Betreiber. Wer einem bestehenden Chat beitritt, lässt das Feld leer."/>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Dein Name"/>
                    <TextBox x:Name="MyNameBox" Style="{StaticResource Input}" AutomationProperties.Name="Dein Name"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Chat-Name"/>
                    <TextBox x:Name="ChatNameBox" Style="{StaticResource Input}" AutomationProperties.Name="Chat-Name"/>
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Gemeinsamer Schlüssel"/>
            <!-- Umschalter als RadioButtons: Zustand für Screenreader und Pfeiltasten-Bedienung -->
            <Border x:Name="KeyModes" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="GenerateButton" Grid.Column="0" GroupName="KeyMode" Style="{StaticResource SegmentButton}"
                                 Tag="Left" Content="Neu erzeugen" Click="Generate_Click"/>
                    <RadioButton x:Name="PasteButton" Grid.Column="1" GroupName="KeyMode" Style="{StaticResource SegmentButton}"
                                 Tag="Right" Content="Einfügen" Click="PasteKey_Click"/>
                </Grid>
            </Border>

            <Border x:Name="KeyArea" Background="{DynamicResource Bg}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=KeyBox}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid>
                        <TextBox x:Name="KeyBox" FontFamily="{StaticResource MonoFont}" FontSize="13" TextWrapping="Wrap"
                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}"
                                 CaretBrush="{DynamicResource Text}" SelectionBrush="{DynamicResource Accent}"
                                 FocusVisualStyle="{x:Null}"
                                 TextChanged="KeyBox_TextChanged" AutomationProperties.Name="Gemeinsamer Schlüssel"/>
                        <TextBlock Margin="4,0,0,0" IsHitTestVisible="False" FontSize="13" VerticalAlignment="Top"
                                   Foreground="{DynamicResource TextMuted}" Text="Schlüssel erzeugen oder vom Kollegen einfügen"
                                   Visibility="{Binding Text, ElementName=KeyBox, Converter={StaticResource EmptyVis}}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="CopyKeyButton" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0"
                                Margin="0,0,8,0" Click="CopyKey_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,6,0"><Canvas Width="24" Height="24"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconCopy}"/></Canvas></Viewbox>
                                <TextBlock x:Name="CopyKeyText" Text="Kopieren" FontSize="12.5"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="QrButton" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0"
                                Click="Qr_Click" Content="Als QR-Code zeigen" FontSize="12.5"/>
                    </StackPanel>
                    <Border x:Name="QrPanel" Visibility="Collapsed" Background="White" CornerRadius="6" Padding="10"
                            HorizontalAlignment="Left" Margin="0,10,0,0">
                        <Image x:Name="QrImage" Width="180" Height="180" RenderOptions.BitmapScalingMode="NearestNeighbor"
                               AutomationProperties.Name="QR-Code des Schlüssels"/>
                    </Border>
                </StackPanel>
            </Border>
            <TextBlock Margin="0,8,0,16" FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"
                       Text="Gib den Schlüssel persönlich oder per Telefon weiter – nicht über diesen Server oder per E-Mail."/>

            <Border x:Name="SafetyPanel" Visibility="Collapsed" Background="{DynamicResource SafeBg}" BorderBrush="{DynamicResource SafeBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconShield}" Stroke="{DynamicResource Lock}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel>
                        <TextBlock Text="Sicherheitscode zum Vergleichen" FontSize="12" Foreground="{DynamicResource SafeText}"/>
                        <TextBlock x:Name="SafetyCode" FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SafeText}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorLine" Visibility="Collapsed" Foreground="{DynamicResource Danger}" FontSize="12.5"
                       TextWrapping="Wrap" Margin="0,4,0,4"/>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
