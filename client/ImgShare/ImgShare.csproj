<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ImgShare</AssemblyName>
    <RootNamespace>ImgShare</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>ImgShare.ico</ApplicationIcon>

    <!-- Versionsressource (Dateieigenschaften → Details). Vollständige Angaben
         senken die Trefferquote heuristischer Virenscanner. -->
    <Product>ImgShare</Product>
    <AssemblyTitle>ImgShare</AssemblyTitle>
    <Description>ImgShare – Ende-zu-Ende-verschlüsselter Bild- und Text-Chat</Description>
    <Company>gerryka</Company>
    <Authors>gerryka</Authors>
    <Copyright>© 2026 gerryka</Copyright>
    <NeutralLanguage>de-AT</NeutralLanguage>
    <RepositoryUrl>https://github.com/gerryka/image-sharing</RepositoryUrl>
  </PropertyGroup>


  <!-- Vorbelegte Server-Adresse: dotnet publish -p:DefaultServer=https://server.example.com:47000
       oder Umgebungsvariable DefaultServer. Leer = Feld startet mit "https://". -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DefaultServer</_Parameter1>
      <_Parameter2>$(DefaultServer)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImgShare.Core\ImgShare.Core.csproj" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>
